aws_region  = "us-east-1"
environment = "dev"
project     = "tap-rag-platform"

# Optional: restrict ALB to your office/VPN CIDR
# alb_ingress_cidrs = ["203.0.113.0/24"]

# Optional: ACM cert enables HTTPS listener + HTTP→443 redirect
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/uuid"

# Optional: TAP reputation HTTP API (empty = JSON files baked into the image)
# reputation_api_base = "https://reputation.tap.internal"
