# ── Application ──
APP_ENV=local
LOG_LEVEL=INFO
USE_MOCK_LLM=true
USE_MOCK_EMBEDDINGS=true

# ── AWS / Bedrock ──
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── RAG ──
DOCS_DIR=./data/docs
CHROMA_PERSIST_DIR=./chroma-db
CHROMA_COLLECTION=tap_docs
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVER_TOP_K=5
RERANK_TOP_N=3
MAX_CHUNKS_PER_SOURCE=2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── API / UI ──
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
# Required in production (or set COGNITO_USER_POOL_ID). Leave empty for local.
API_AUTH_TOKEN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Comma-separated. Empty = localhost Streamlit in prod, * locally.
CORS_ORIGINS=

# ── S3 ──
S3_BUCKET=tap-rag-platform-dev-artifacts
S3_CHROMA_PREFIX=chroma/
S3_FEEDBACK_PREFIX=feedback/
S3_EVAL_PREFIX=evals/
CHROMA_S3_SYNC=false

# ── LoRA / classifier ──
LORA_ADAPTER_DIR=./lora-adapters
LORA_BASE_MODEL=meta-llama/Llama-2-7b-chat-hf
LORA_CONFIDENCE_THRESHOLD=0.70
HF_TOKEN=
TRAINING_DATA_PATH=./data/training/tap_training_data.json

# ── Reputation (empty API base = JSON files under REPUTATION_DATA_DIR) ──
REPUTATION_DATA_DIR=./data/reputation
REPUTATION_API_BASE=
REPUTATION_API_TOKEN=

# ── Agent ──
AGENT_MAX_ITERATIONS=15
AGENT_DIFF_DELETE_THRESHOLD=50

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
